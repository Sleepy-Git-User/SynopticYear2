<!DOCTYPE html>
<html style="font-family: 'Roboto Slab', sans-serif">
	<head style="font-family: 'Roboto Slab', sans-serif">
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
			style="font-family: 'Roboto Slab', sans-serif"
		/>
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin
			style="font-family: 'Roboto Slab', sans-serif"
		/>
	</head>
	<body
		style="
			font-family: 'Roboto Slab', sans-serif;
			margin: 0 auto;
			padding: 0;
			max-width: 900px;
			color: #000 !important;
		"
	>
		<header
			class="header"
			style="
				font-family: 'Roboto Slab', sans-serif;
				padding: 20px;
				margin: 30px 0;
				background-color: #defaff;
			"
		>
		<table cellspacing="0" cellpadding="0" border="0" align="center">
			<tr>

			<td>
			<img
				src="./logo.png"
				alt="logo"
				width="100"
				height="100"
				style="
					font-family: 'Roboto Slab', sans-serif;
					margin-right: 15px;
				"
			/>
			</td>
			<td>
			<h1 style="font-family: 'Roboto Slab', sans-serif">
				Grab-It & Govan
			</h1>
			</td>
			</tr>
			</table>
		</header>

		<div
			class="content"
			style="
				font-family: 'Roboto Slab', sans-serif;
				background-color: #f1f1f1;
				margin: 0 auto;
				padding: 20px;
			"
		>
			<h1
				id="title"
				style="
					font-family: 'Roboto Slab', sans-serif;
					font-size: 40px;
					text-align: center;
					margin-top: 50px;
					margin-bottom: 50px;
				"
			>
				Thank you for joining us!
			</h1>
			<div
				class="contentInfo"
				style="
					font-family: 'Roboto Slab', sans-serif;
					margin: 0 auto;
					max-width: 750px;
				"
			>
				<p
					style="
						font-family: 'Roboto Slab', sans-serif;
						text-align: center;
						font-size: 20px;
					"
				>
					Here at Grab-It & Govan we are dedicated to helping you find
					the best deals in your area.
				</p>
				<p
					style="
						font-family: 'Roboto Slab', sans-serif;
						text-align: center;
						font-size: 20px;
					"
				>
					Our goal is to help you save money and time by providing you
					with a platform to buy and sell items locally.
				</p>
				<p
					style="
						font-family: 'Roboto Slab', sans-serif;
						text-align: center;
						font-size: 20px;
					"
				>
					So what are you waiting for? Start saving today!
				</p>
			</div>
			<ul
				class="links"
				style="
					font-family: 'Roboto Slab', sans-serif;
					list-style: none;
					display: inline-block;
					width: 750px;
					margin: 50px auto;
					text-align: center;
				"
			>
				<li
					class="link1"
					style="
						font-family: 'Roboto Slab', sans-serif;
						margin-bottom: 20px;
					"
				>
				<table cellspacing="0" cellpadding="0" border="0" align="center">
					<tr>

					<td>
					<img
						class="linkImg"
						src="https://synopticproject.blob.core.windows.net/images/hoticon.png"
						alt="logo"
						width="100"
						height="100"
						style="
							font-family: 'Roboto Slab', sans-serif;
							margin-right: 20px;
							border-radius: 50%;
						"
					/>
					</td>
					<td>
					<h1
						style="
							font-family: 'Roboto Slab', sans-serif;
							font-size: 20px;
						"
					>
						<a
							href="http://localhost:5173/Listings"
							style="font-family: 'Roboto Slab', sans-serif"
							>See whats hot</a
						>
					</h1>
					</td>
					</tr>
					</table>
				</li>

				<li
				
					class="link2"
					style="
						font-family: 'Roboto Slab', sans-serif;
						margin-bottom: 20px;
					"
				>
				<table cellspacing="0" cellpadding="0" border="0" align="center">
					<tr>

					<td>
					<img
						class="linkImg"
						src="https://synopticproject.blob.core.windows.net/images/superman.png"
						alt="logo"
						width="100"
						height="100"
						style="
							font-family: 'Roboto Slab', sans-serif;
							margin-right: 20px;
							border-radius: 50%;
						"
					/>
					</td>
					<td>
					<h1
						style="
							font-family: 'Roboto Slab', sans-serif;
							font-size: 20px;
						"
					>
						<a
							href="http://localhost:5173/Listings"
							style="font-family: 'Roboto Slab', sans-serif"
							>Find foods to save</a
						>
					</h1>
					</td>
					</tr>
					</table>
				</li>

				<li
					class="link3"
					style="
						font-family: 'Roboto Slab', sans-serif;
						margin-bottom: 20px;
					"
				>
				<table cellspacing="0" cellpadding="0" border="0" align="center">
					<tr>

					<td>
					<img
						class="linkImg"
						src="https://synopticproject.blob.core.windows.net/images/security.png"
						alt="logo"
						width="100"
						height="100"
						style="
							font-family: 'Roboto Slab', sans-serif;
							margin-right: 20px;
							border-radius: 50%;
						"
					/>
					</td>
					<td>
					<h1
						style="
							font-family: 'Roboto Slab', sans-serif;
							font-size: 20px;
						"
					>
						<a
							href="http://localhost:5173/Account"
							style="font-family: 'Roboto Slab', sans-serif"
							>Go to your account</a
						>
					</h1>
					</td>
					</tr>
					</table>
				</li>
			</ul>
		</div>
	</body>
	<footer
		class="footer"
		style="
			font-family: 'Roboto Slab', sans-serif;
			background-color: #131a22;
			text-align: center;
			padding: 10px;
			color: white;
			margin-top: 50px;
		"
	>
		<p style="font-family: 'Roboto Slab', sans-serif">Grab-It & Govan</p>
		<p style="font-family: 'Roboto Slab', sans-serif">123-456-7890</p>
		<p style="font-family: 'Roboto Slab', sans-serif">
			1234 Grab-It & Govan Street
		</p>
		<p style="font-family: 'Roboto Slab', sans-serif">
			Grab-It & Govan, NY 12345
		</p>
	</footer>
</html>
