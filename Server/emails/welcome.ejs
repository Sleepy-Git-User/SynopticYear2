<!DOCTYPE html>
<html>
	<head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;500;600&display=swap" rel="stylesheet">
		<style>
            *{
                font-family: 'Roboto Slab', sans-serif;
            }

            body{
                margin: 0 auto;
                padding: 0;
                max-width: 900px;
            }
			.header {
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
                margin: 30px 0;
                background-color: #defaff;
			}

			.header img {
				margin-right: 15px;
			}

			.content {
				
                background-color: #f1f1f1;
				margin: 0 auto;
                padding: 20px;
			}

            .contentInfo{
                margin: 0 auto;
                max-width: 750px;
            }

			.content p {
				text-align: center;
				font-size: 20px;
			}

			.content #title {
				font-size: 40px;
				text-align: center;
				margin-top: 50px;
				margin-bottom: 50px;
			}
			.footer {
				background-color: #131A22;
				text-align: center;
				padding: 10px;
                color: white;
                margin-top: 50px;
			}

			.links {
				display: flex;
				flex-direction: column;
				width: 60%;
				margin: 50px auto;
                
                
			}

            .links div{
                margin-bottom: 20px;
            }

            .links h1{
                font-size: 20px;
            }

			.link1 {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-start;
			}

			.linkImg{
                margin-right: 20px;
                border-radius: 50%;
            }

            .linkImg img{
                width: 50%;
                
            }

			.link2 {
				display: flex;
				flex-direction: row;
                align-items: center;
				justify-content: flex-start;
			}

			.link3 {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-start;
			}
		</style>
	</head>
	<body>
		<header class="header">
			<img
				src="https://i.imgur.com/4z2ZQZS.png"
				alt="logo"
				width="100"
				height="100"
			/>
			<h1>Grab-It & Govan</h1>
		</header>

		<div class="content">
			<h1 id="title">Thank you for joining us!</h1>
            <div class="contentInfo">
                <p>
                    Here at Grab-It & Govan we are dedicated to helping you find the
                    best deals in your area.
                </p>
                <p>
                    Our goal is to help you save money and time by providing you
                    with a platform to buy and sell items locally.
                </p>
                <p>So what are you waiting for? Start saving today!</p>
            </div>
			<div class="links">
				<div class="link1">
					<img
						class="linkImg"
						src="./hoticon.png"
						alt="logo"
						width="100"
						height="100"
					/>
					<h1>See whats hot</h1>
				</div>

				<div class="link2">
					<img
						class="linkImg"
						src="./superman.png"
						alt="logo"
                        width="100"
                        height="100"
					/>
					<h1>Find foods to save</h1>
				</div>

				<div class="link3">
					<img
						class="linkImg"
						src="./account.png"
						alt="logo"
						width="100"
						height="100"
					/>
					<h1>Go to your account</h>
				</div>
			</div>
		</div>
		<footer class="footer">
			<p>Grab-It & Govan</p>
			<p>123-456-7890</p>
			<p>1234 Grab-It & Govan Street</p>
			<p>Grab-It & Govan, NY 12345</p>
		</footer>
	</body>
</html>

