<!DOCTYPE html>
<html style="font-family: 'Roboto Slab', sans-serif">
	<head style="font-family: 'Roboto Slab', sans-serif">
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
			style="font-family: 'Roboto Slab', sans-serif"
		/>
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin
			style="font-family: 'Roboto Slab', sans-serif"
		/>
	</head>
	<body
		style="
			font-family: 'Roboto Slab', sans-serif;
			margin: 0 auto;
			padding: 0;
			max-width: 900px;
		"
	>
		<header
			class="header"
			style="
				font-family: 'Roboto Slab', sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
				margin: 30px 0;
				background-color: #defaff;
			"
		>
			<img
				src="./logo.png"
				alt="logo"
				width="100"
				height="100"
				style="
					font-family: 'Roboto Slab', sans-serif;
					margin-right: 15px;
				"
			/>
			<h1 style="font-family: 'Roboto Slab', sans-serif">
				Grab-It & Govan
			</h1>
		</header>

		<div
			class="content"
			style="
				font-family: 'Roboto Slab', sans-serif;
				background-color: #f1f1f1;
				margin: 0 auto;
				padding: 20px;
			"
		>
			<h1
				id="title"
				style="
					font-family: 'Roboto Slab', sans-serif;
					font-size: 40px;
					text-align: center;
					margin-top: 50px;
					margin-bottom: 50px;
				"
			>
				Thank you for joining us!
			</h1>
			<div
				class="contentInfo"
				style="
					font-family: 'Roboto Slab', sans-serif;
					margin: 0 auto;
					max-width: 750px;
				"
			>
				<p
					style="
						font-family: 'Roboto Slab', sans-serif;
						text-align: center;
						font-size: 20px;
					"
				>
					Here at Grab-It & Govan we are dedicated to helping you find
					the best deals in your area.
				</p>
				<p
					style="
						font-family: 'Roboto Slab', sans-serif;
						text-align: center;
						font-size: 20px;
					"
				>
					Our goal is to help you save money and time by providing you
					with a platform to buy and sell items locally.
				</p>
				<p
					style="
						font-family: 'Roboto Slab', sans-serif;
						text-align: center;
						font-size: 20px;
					"
				>
					So what are you waiting for? Start saving today!
				</p>
			</div>
			<div
				class="links"
				style="
					font-family: 'Roboto Slab', sans-serif;
					display: flex;
					flex-direction: column;
					width: 60%;
					margin: 50px auto;
				"
			>
				<div
					class="link1"
					style="
						font-family: 'Roboto Slab', sans-serif;
						display: flex;
						flex-direction: row;
						align-items: center;
						justify-content: flex-start;
						margin-bottom: 20px;
					"
				>
					<img
						class="linkImg"
						src="./hoticon.png"
						alt="logo"
						width="100"
						height="100"
						style="
							font-family: 'Roboto Slab', sans-serif;
							margin-right: 20px;
							border-radius: 50%;
						"
					/>
					<h1
						style="
							font-family: 'Roboto Slab', sans-serif;
							font-size: 20px;
						"
					>
						<a
							href="http://localhost:5173/Listings"
							style="font-family: 'Roboto Slab', sans-serif"
							>See whats hot</a
						>
					</h1>
				</div>

				<div
					class="link2"
					style="
						font-family: 'Roboto Slab', sans-serif;
						display: flex;
						flex-direction: row;
						align-items: center;
						justify-content: flex-start;
						margin-bottom: 20px;
					"
				>
					<img
						class="linkImg"
						src="./superman.png"
						alt="logo"
						width="100"
						height="100"
						style="
							font-family: 'Roboto Slab', sans-serif;
							margin-right: 20px;
							border-radius: 50%;
						"
					/>
					<h1
						style="
							font-family: 'Roboto Slab', sans-serif;
							font-size: 20px;
						"
					>
						<a
							href="http://localhost:5173/Listings"
							style="font-family: 'Roboto Slab', sans-serif"
							>Find foods to save</a
						>
					</h1>
				</div>

				<div
					class="link3"
					style="
						font-family: 'Roboto Slab', sans-serif;
						display: flex;
						flex-direction: row;
						align-items: center;
						justify-content: flex-start;
						margin-bottom: 20px;
					"
				>
					<img
						class="linkImg"
						src="./account.png"
						alt="logo"
						width="100"
						height="100"
						style="
							font-family: 'Roboto Slab', sans-serif;
							margin-right: 20px;
							border-radius: 50%;
						"
					/>
					<h1
						style="
							font-family: 'Roboto Slab', sans-serif;
							font-size: 20px;
						"
					>
						<a
							href="http://localhost:5173/Account"
							style="font-family: 'Roboto Slab', sans-serif"
							>Go to your account</a
						>
					</h1>
				</div>
			</div>
		</div>
	</body>
	<footer
		class="footer"
		style="
			font-family: 'Roboto Slab', sans-serif;
			background-color: #131a22;
			text-align: center;
			padding: 10px;
			color: white;
			margin-top: 50px;
		"
	>
		<p style="font-family: 'Roboto Slab', sans-serif">Grab-It & Govan</p>
		<p style="font-family: 'Roboto Slab', sans-serif">123-456-7890</p>
		<p style="font-family: 'Roboto Slab', sans-serif">
			1234 Grab-It & Govan Street
		</p>
		<p style="font-family: 'Roboto Slab', sans-serif">
			Grab-It & Govan, NY 12345
		</p>
	</footer>
</html>
