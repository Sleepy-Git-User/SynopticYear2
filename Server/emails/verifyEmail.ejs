<html style="font-family: 'Roboto Slab', sans-serif">
	<head style="font-family: 'Roboto Slab', sans-serif">
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
			style="font-family: 'Roboto Slab', sans-serif"
		/>
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin
			style="font-family: 'Roboto Slab', sans-serif"
		/>
	</head>
	<body
		style="
			font-family: 'Roboto Slab', sans-serif;
			margin: 30px auto;
			padding: 0;
			max-width: 900px;
		"
	>
		<header
			class="header"
			style="
				font-family: 'Roboto Slab', sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 20px;
				margin: 30px 0;
				background-color: #defaff;
			"
		>
			<img
				src="./logo.png"
				alt="logo"
				width="100"
				height="100"
				style="
					font-family: 'Roboto Slab', sans-serif;
					margin-right: 15px;
				"
			/>
			<h1 style="font-family: 'Roboto Slab', sans-serif">
				Grab-It & Govan
			</h1>
		</header>
		<div
			class="content"
			style="
				font-family: 'Roboto Slab', sans-serif;
				background-color: #f1f1f1;
				margin: 0 auto;
				padding: 15px;
				align-items: center;
			"
		>
			<h1
				id="title"
				style="
					font-family: 'Roboto Slab', sans-serif;
					font-size: 40px;
					text-align: center;
					margin-top: 50px;
					margin-bottom: 50px;
				"
			>
				Verify your email address
			</h1>
			<div
				class="contentImg"
				style="
					font-family: 'Roboto Slab', sans-serif;
					margin-right: 20px;
					border-radius: 50%;
					text-align: center;
					margin-bottom: 50px;
				"
			>
				<img
					src="https://drive.google.com/uc?export=view&id=1zDtdCGtIwR87uH2yTjBc1xxH5Fig6GIb"
					alt="email"
					width="300"
					height="300"
					style="font-family: 'Roboto Slab', sans-serif"
				/>
			</div>
			<div
				class="contentInfo"
				style="
					font-family: 'Roboto Slab', sans-serif;
					margin: 0 auto;
					max-width: 70%;
					font-size: 20px;
				"
			>
				<p style="font-family: 'Roboto Slab', sans-serif">
					Thank you for registering with Grab-It & Govan. Please click
					the link below to verify your email address.
				</p>
				<div
					id="btn"
					style="
						text-align: center;
						font-family: 'Roboto Slab', sans-serif;
						background-color: #defaff;
						border: none;
						color: black;
						padding: 20px 32px;
						text-decoration: none;
						font-size: 20px;
						font-weight: bolder;
						margin: 50px 2px;
						cursor: pointer;
						border-radius: 12px;
					"
				>
					<a
						href=<%= url %>
						style="
							font-family: 'Roboto Slab', sans-serif;
							text-decoration: none;
							color: black;
						"
						>Confirm your email address</a
					>
				</div>
			</div>
		</div>
	</body>
	<footer
		class="footer"
		style="
			font-family: 'Roboto Slab', sans-serif;
			background-color: #131a22;
			text-align: center;
			padding: 10px;
			color: white;
			margin-top: 50px;
		"
	>
		<p style="font-family: 'Roboto Slab', sans-serif">Grab-It & Govan</p>
		<p style="font-family: 'Roboto Slab', sans-serif">123-456-7890</p>
		<p style="font-family: 'Roboto Slab', sans-serif">
			1234 Grab-It & Govan Street
		</p>
		<p style="font-family: 'Roboto Slab', sans-serif">
			Grab-It & Govan, NY 12345
		</p>
	</footer>
</html>
